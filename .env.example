# Copia este archivo a .env.local y rellena la clave.
# .env.local está ignorado por git (*.local).

# LLM (sin clave, todo funciona en modo determinista)
MCPORTAL_LLM_PROVIDER=anthropic
MCPORTAL_LLM_API_KEY=
MCPORTAL_MODEL=claude-sonnet-5-5
MCPORTAL_EFFORT_SYNTH=medium
MCPORTAL_CONTACT=https://github.com/cesecese/MCPortal

# Portal: mock (maqueta) o registry (fase 3)
NEXT_PUBLIC_DATA_SOURCE=mock
NEXT_PUBLIC_REGISTRY_URL=http://localhost:8010
